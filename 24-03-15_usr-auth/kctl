#!/bin/bash

mkdir -p .certs
find .certs -type f -delete

vagrant ssh -c 'cat /etc/kubernetes/pki/user/vagrant.crt' > .certs/vagrant.crt
vagrant ssh -c 'cat /etc/kubernetes/pki/user/vagrant.key' > .certs/vagrant.key

SERVER='https://kubernetes.default.svc.cluster.local:6443'
kubectl \
	--client-certificate .certs/vagrant.crt \
	--client-key .certs/vagrant.key \
	--server=$SERVER\
	--insecure-skip-tls-verify \
	"$@"
