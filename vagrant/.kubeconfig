apiVersion: v1
kind: Config

clusters:
- cluster:
    certificate-authority: .certs/api-ca.crt
    server: https://10.1.2.10:9443
  name: myk8s

users:
  - name: superadmin
    user:
      insecure-skip-tls-verify: false
      client-certificate: .certs/superadmin.crt
      client-key: .certs/superadmin.key

contexts:
- name: vagrant
  context:
    cluster: myk8s
    user: superadmin
    namespace: default

current-context: vagrant

# To convert a certificate to base64 for use with `*-data:` API, use:
# openssl base64 -in .certs/api-ca.crt |sed -e ':a;N;$!ba;s/\n//g' -e 's/ //g'
