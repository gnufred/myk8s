apiVersion: v1
kind: Config

clusters:
- cluster:
    certificate-authority: .certs/api-ca.crt
    server: https://10.1.2.10:9443
  name: myk8s

users:
  - name: superadmin
    user:
      client-certificate: .certs/superadmin.crt
      client-key: .certs/superadmin.key
      #insecure-skip-tls-verify: true

contexts:
- name: vagrant
  context:
    cluster: myk8s
    user: superadmin
    namespace: default

current-context: vagrant
