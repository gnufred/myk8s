#!/bin/bash

# print help
usage() {
	echo "Run a Playbook on a Vagrant guest

USAGE:
    run/playbook [OPTIONS]
    run/playbook --help

OPTIONS:
    -h, --host <HOST> string (optional)
            The host to run the playbook on.

    -p, --playbook <PLAYBOOK> string (mandatory)
            The playbook to run.

    -b, --book <PLAYBOOK> string (special)
            Alias for -p, --playbook.

    -t, --tags <TAGS> string (optional)
            Run selected tags.

    -x, --extra-vars <JSON> string (optional)
            Pass extra variables."
}

# process args
# https://linuxcommand.org/lc3_wss0120.php
while [ "$1" != "" ]; do
    case $1 in
		     --help ) usage; exit;;
        -h | --host ) shift; HOST="$1";;
        -p | --playbook ) shift; PLAYBOOK="$1";;
        -b | --book ) shift; BOOK="$1";;
        -t | --tags ) shift; TAGS="$1";;
		-x | --extra-vars ) shift; XVARS="$1";;
    esac
    shift
done

if [[ -n "$BOOK" ]]; then
	PLAYBOOK="$BOOK"
fi

if [[ -z "$PLAYBOOK" ]]; then
	echo "ERROR: Playbook name required."
	exit
else
	PLAYBOOK="pb/$PLAYBOOK/main.yml"
fi

# https://docs.ansible.com/ansible/latest/scenario_guides/guide_vagrant.html
INVENTORY=.vagrant/provisioners/ansible/inventory/vagrant_ansible_inventory 
ansible-playbook -i $INVENTORY $PLAYBOOK ${TAGS:+"--tags" "$TAGS"} ${HOST:+"-l" "$HOST"} ${XVARS:+"--extra-vars" "$XVARS"}
