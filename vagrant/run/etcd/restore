#!/bin/bash

# print help
usage() {
	echo "Restore an etcd snapshot

USAGE:
    run/etcd/restore [OPTIONS]
    run/etcd/restore --help

SUBCOMMANDS:
    run/etcd/restore list
            List available snapshots.

OPTIONS:
    -f, --file <FILE> etcd snapshot (mandatory)
            The etcd snapshot to recover."
}

# process args
# https://linuxcommand.org/lc3_wss0120.php
SUBCOMMAND="$1"
while [ "$1" != "" ]; do
    case $1 in
		     --help ) usage; exit;;
        -f | --file ) shift; FILE="$1";;
    esac
    shift
done

if [[ "$SUBCOMMAND" == "list" ]]; then
	find pb/ic/files -name '*.db'|sort|sed 's,pb/ic/files/,,'
	exit 0
fi

if [[ -z "$FILE" ]]; then
	echo "ERROR: Backup file name required.
Use the 'list' subcommand to available snapshots."
	exit 1
fi

run/playbook \
	-h "cp0" \
	-b ic \
    -t etcd_restore \
	-x "{\"backup_file\":\"${FILE}\"}"
