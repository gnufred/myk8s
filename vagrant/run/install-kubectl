#!/bin/bash
cur_home="$HOME"
tmp="$cur_home/kubectl_install_tmp"

if [ "$EUID" -ne 0 ]; then
    echo "ERROR: need to run this script as root"
    exit 1
fi

echo "download kubectl latest stable"
mkdir "$tmp"
stable=$(curl -L -s https://dl.k8s.io/release/stable.txt)
echo "latest stable: $stable"
curl -LO "https://dl.k8s.io/release/$stable/bin/linux/amd64/kubectl"

echo "validate download"
curl -LO "https://dl.k8s.io/release/$stable/bin/linux/amd64/kubectl.sha256"
exp="kubectl: OK"
got=$(echo "$(cat kubectl.sha256)  kubectl" | sha256sum --check)
if [[ "$got" != "$exp" ]]; then
    echo "ERROR: sha256 checksum doesn't match"
    echo "expect: $exp"
    echo "got: $got"
    exit 2
fi

echo "install"
install -o root -g root -m 0755 kubectl /usr/local/bin/kubectl
exp="/usr/local/bin/kubectl"
got=$(which kubectl)
if [[ "$got" != "$exp" ]]; then
    echo "ERROR: install path doesn't match"
    echo "expect: $exp"
    echo "got: $got"
    exit 3
fi
exp="Client Version: $stable"
got=$(kubectl version --client|head -n1)
if [[ "$got" != "$exp" ]]; then
    echo "ERROR: binary version doesn't match"
    echo "expect: $exp"
    echo "got: $got"
    exit 4
fi

echo "cleanup"
rm kubectl
rm kubectl.sha256
rmdir "$tmp"

echo "done"
echo "happy kubernetesing"

