#!/bin/bash

# print help
usage() {
	echo "Provision Vagrant VMs

USAGE:
    run/provision <HOST> (optional)
    run/provision --help

HOST:
    Must be a hostname or a empty value.
	Empty value means all hosts."
}

if [[ "$1" == "-h" ]] || [[ "$1" == "--help" ]]; then
	usage
	exit
else
	HOST="$1"
fi

NAME="cp1"
if [[ -z "$HOST" ]] || [[ "$HOST" == "$NAME" ]]; then 
	vagrant up --provision $NAME && \
	run/playbook -h $NAME -b install && \
	run/playbook -h $NAME -b ufw && \
	run/playbook -h $NAME -b init && \
	run/playbook -h $NAME -b auth && \
	run/playbook -h $NAME -b bash && \
	echo "[$NAME] provisioning completed."
fi

NAME="wo1"
if [[ -z "$HOST" ]] || [[ "$HOST" == "$NAME" ]]; then 
	vagrant up --provision $NAME && \
	run/playbook -h $NAME -b ufw && \
	run/playbook -h $NAME -b install && \
	run/playbook -b join && \
	echo "[$NAME] provisioning completed."
fi
