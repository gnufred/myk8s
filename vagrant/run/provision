#!/bin/bash

# print help
usage() {
	echo "Provision Vagrant VMs

USAGE:
    run/provision <HOST> (optional)
    run/provision --help

HOST:
    Must be a hostname or a empty value.
	Empty value means all hosts."
}

if [[ "$1" == "-h" ]] || [[ "$1" == "--help" ]]; then
	usage
	exit
else
	HOST="$1"
fi

# Fix: https://gitlab.com/gnufred/myk8s/-/issues/1
randomize_port() {
	if [[ "$NAME" == "cp1" ]]; then
		run/randomize-port "$NAME"
	fi
}

provision() {
	if [[ -z "$HOST" ]] || [[ "$HOST" == "$NAME" ]]; then 
		echo "[$NAME] provisioning started"
		vagrant up --provision $NAME && \
		for B in ${BOOKS[@]}; do run/playbook -h $NAME -b $B; done && \
		echo "[$NAME] provisioning completed"
		echo ""
	fi
}

join_worker() {
	if [[ -z "$HOST" ]] || [[ "$HOST" == "$NAME" ]]; then 
		echo "[$NAME] joining cluster $CLUSTER"
		run/playbook -h "$CLUSTER $WORKER" -b join && \
		echo "[$NAME] joined cluster $CLUSTER"
	fi
}

NAME=cp1
BOOKS=(install ufw init auth bash)
randomize_port $NAME
provision $NAME $BOOKS

NAME=wo1
BOOKS=(install ufw)
provision $NAME $BOOKS

CLUSTER=cp1
WORKER=wo1
join_worker $CLUSTER $WORKER
