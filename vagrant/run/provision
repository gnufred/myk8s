#!/bin/bash

# print help
usage() {
	echo "Provision Vagrant VMs

USAGE:
    run/provision <HOST> (optional)
    run/provision --help

HOST:
    Must be a hostname or a empty value.
	Empty value means all hosts."
}

if [[ "$1" == "-h" ]] || [[ "$1" == "--help" ]]; then
	usage
	exit
fi

HOST="$1"

prestart() {
	# delete previous join commands
	find -name '.join*' -delete
}

provision() {
	if [[ -z "$HOST" ]] || [[ "$HOST" == "$NODE" ]]; then 
		echo "[$NODE] provisioning started"
		vagrant up --provision $NODE && \
		for B in ${BOOKS[@]}; do run/playbook -h $NODE -b $B; done && \
		echo "[$NODE] provisioning completed"
		echo ""
	fi
}

join() {
	if [[ -z "$HOST" ]] || [[ "$HOST" == "$NODE" ]]; then 
		echo "[$NODE] joining cluster $MAIN"
		. run/join "$NODE" && \
		echo "[$NODE] joined cluster $MAIN"
	fi
}

load_balancer() {
	NAME=lb
	BOOKS=(ufw install haproxy)
	for i in 0; do
		NODE="$NAME$i"
		provision $NODE $BOOKS
	done
}

cplane_main(){
	MAIN=cp0
	NAME=cp
	BOOKS=(ufw install init auth)
	for i in 0; do
		NODE="$NAME$i"
		provision $NODE $BOOKS
	done
}

cplane_replica(){
	BOOKS=(ufw install)
	for i in {1..2}; do
		NODE="$NAME$i"
		provision $NODE $BOOKS && \
		join $MAIN $NODE &
	done
	wait
}

worker() {
	NAME=wo
	BOOKS=(ufw install)
	for i in {0..5}; do
		NODE="$NAME$i"
		provision $NODE $BOOKS && \
		join $MAIN $NODE &
	done
	wait
}

prestart
load_balancer
cplane_main
cplane_replica
worker
