#!/bin/bash

# print help
usage() {
	echo "Provision Vagrant VMs

USAGE:
    run/provision <HOST> (optional)
    run/provision --help

HOST:
    Must be a hostname or a empty value.
	Empty value means all hosts."
}

if [[ "$1" == "-h" ]] || [[ "$1" == "--help" ]]; then
	usage
	exit
else
	HOST="$1"
fi

provision() {
	if [[ -z "$HOST" ]] || [[ "$HOST" == "$NODE" ]]; then 
		echo "[$NODE] provisioning started"
		vagrant up --provision $NODE && \
		for B in ${BOOKS[@]}; do run/playbook -h $NODE -b $B; done && \
		echo "[$NODE] provisioning completed"
		echo ""
	fi
}

join() {
	if [[ -z "$HOST" ]] || [[ "$HOST" == "$NODE" ]]; then 
		echo "[$NODE] joining cluster $CLUSTER"
		run/playbook -h "$CLUSTER $NODE" -b join && \
		echo "[$NODE] joined cluster $CLUSTER"
	fi
}

NAME=lb
BOOKS=(ufw haproxy)
for i in 0; do
	NODE="$NAME$i"
	provision $NODE $BOOKS
done

CLUSTER=cp0
NAME=cp
BOOKS=(ufw install init auth bash)
for i in 0; do
	NODE="$NAME$i"
	provision $NODE $BOOKS
done

BOOKS=(ufw install)
for i in {1..2}; do
	NODE="$NAME$i"
	provision $NODE $BOOKS
	join $CLUSTER $NODE
done

NAME=wo
BOOKS=(ufw install)
for i in {0..5}; do
	NODE="$NAME$i"
	provision $NODE $BOOKS
	join $CLUSTER $NODE
done
