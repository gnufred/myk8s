#!/bin/bash

# print help
usage() {
	echo "Provision Vagrant VMs

USAGE:
    run/provision <HOST> (optional)
    run/provision --help

HOST:
    Must be a hostname or a empty value.
	Empty value means all hosts."
}

if [[ "$1" == "-h" ]] || [[ "$1" == "--help" ]]; then
	usage
	exit
fi

HOST="$1"

# Resolve the lab directory before invoking its helpers.
cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." || exit 1

exit_on_error() {
	if [[ "$1" -ne "0" ]]; then
		echo "$2"
		exit $1
	fi
}

prestart() {
	# delete previous join commands
	find -name '.join*' -delete
}

provision() {
	if [[ -z "$HOST" ]] || [[ "$HOST" == "$NODE" ]]; then 
		echo "[$NODE] provisioning started"
		vagrant up --provision "$NODE" || return $?
		for B in ${BOOKS[@]}; do
			run/playbook -h $NODE -b $B
			exit_on_error $? "[$NODE] provisioning failed"
		done
		echo -e "[$NODE] provisioning completed\n"
	fi
}

join() {
	if [[ -z "$HOST" ]] || [[ "$HOST" == "$NODE" ]]; then 
		echo "[$NODE] joining cluster $MAIN"
		. run/join "$NODE" && \
		echo "[$NODE] joined cluster $MAIN"
	fi
}

load_balancer() {
	NAME=lb
	BOOKS=(ufw install haproxy dns)
	for i in 0; do
		NODE="$NAME$i"
		provision $NODE $BOOKS
		exit_on_error $? "[$NODE] provisioning failed"
	done
}

cplane_main(){
	MAIN=cp0
	NAME=cp
	BOOKS=(ufw install init auth dns)
	for i in 0; do
		NODE="$NAME$i"
		provision $NODE $BOOKS
		exit_on_error $? "[$NODE] provisioning failed"
	done
}

cplane_replica(){
	NAME=cp
	BOOKS=(ufw install)
	# Add stacked-etcd members one at a time and report join failures.
	for i in {1..2}; do
		NODE="$NAME$i"
		provision "$NODE" "${BOOKS[@]}"
		exit_on_error $? "[$NODE] provisioning failed"
		join "$MAIN" "$NODE"
		exit_on_error $? "[$NODE] joining cluster failed"
	done
}

nfs() {
	NAME=nf
	BOOKS=(ufw install)
	NFS_PROVISION_PID=""
	for i in {0..0}; do
		NODE="$NAME$i"
		if [[ -n "$HOST" && "$HOST" != "$NODE" ]]; then continue; fi
		provision "$NODE" "${BOOKS[@]}" &
		NFS_PROVISION_PID=$!
	done
}

worker() {
	NAME=wo
	BOOKS=(ufw install)
	local worker_pids=() worker_nodes=()
	local index status=0 result
	for i in {0..5}; do
		NODE="$NAME$i"
		if [[ -n "$HOST" && "$HOST" != "$NODE" ]]; then continue; fi
		provision "$NODE" "${BOOKS[@]}" && join "$MAIN" "$NODE" &
		worker_pids+=("$!")
		worker_nodes+=("$NODE")
	done
	# Preserve parallel provisioning, but check every worker's result.
	for index in "${!worker_pids[@]}"; do
		if wait "${worker_pids[$index]}"; then
			:
		else
			result=$?
			echo "[${worker_nodes[$index]}] provisioning or joining failed" >&2
			status=$result
		fi
	done
	return "$status"
}

run/register-box || exit $?

prestart
load_balancer
cplane_main
cplane_replica
nfs
worker
worker_status=$?
# Keep NFS and workers parallel, but never hide a failed NFS provision.
if [[ -n "$NFS_PROVISION_PID" ]]; then
	wait "$NFS_PROVISION_PID"
	exit_on_error $? "[nf0] provisioning failed"
fi
exit "$worker_status"
