#!/bin/bash

SERVER='localhost'
PORT=$(grep 'myk8s.vm.network "forwarded_port"' Vagrantfile|awk '{print $6}')

USER=$(cat playbook/myk8s/auth/main.yml|grep ' user:'|awk '{print $2}')

CACRT=".certs/api-ca.crt"
USCRT=".certs/$USER.crt"
USKEY=".certs/$USER.key"

kubectl \
	--server="https://$SERVER:$PORT" \
	--certificate-authority "$CACRT" \
	--client-certificate "$USCRT" \
	--client-key "$USKEY" \
	"$@"
