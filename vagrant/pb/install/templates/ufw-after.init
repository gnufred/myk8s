#!/bin/sh
# Installed by Ansible. Preserve Pod IPs across nodes; NAT only outside the Pod CIDR.
set -eu
case "${1:-}" in
    start)
        if ! iptables -w -t nat -C POSTROUTING -s {{ lab_nodes[inventory_hostname].pod_subnet }} ! -d {{ lab_pod_subnet }} -m comment --comment myk8s-pod-egress -j MASQUERADE 2>/dev/null; then
            iptables -w -t nat -A POSTROUTING -s {{ lab_nodes[inventory_hostname].pod_subnet }} ! -d {{ lab_pod_subnet }} -m comment --comment myk8s-pod-egress -j MASQUERADE
            echo 'Configured Pod egress NAT'
        fi
        ;;
    stop|flush-all)
        if iptables -w -t nat -C POSTROUTING -s {{ lab_nodes[inventory_hostname].pod_subnet }} ! -d {{ lab_pod_subnet }} -m comment --comment myk8s-pod-egress -j MASQUERADE 2>/dev/null; then
            iptables -w -t nat -D POSTROUTING -s {{ lab_nodes[inventory_hostname].pod_subnet }} ! -d {{ lab_pod_subnet }} -m comment --comment myk8s-pod-egress -j MASQUERADE
        fi
        ;;
    status) ;;
    *) echo "Usage: $0 {start|stop|flush-all|status}" >&2; exit 2 ;;
esac
